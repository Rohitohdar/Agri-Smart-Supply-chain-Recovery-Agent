# Copy to .env.local and adjust. Vite only exposes VITE_-prefixed variables to
# the browser, which is why nothing secret belongs in this file.
#
# There is no API key here on purpose: the console asks the operator for it at
# runtime and keeps it in the browser's localStorage, so no credential is ever
# committed or baked into a bundle.

# Where the backend is. Defaults to http://127.0.0.1:8000.
VITE_API_BASE_URL=http://127.0.0.1:8000

# Display-only currency symbol. The backend stores bare numbers and has no
# currency concept, so this only changes how costs are printed.
VITE_CURRENCY_SYMBOL=₹
