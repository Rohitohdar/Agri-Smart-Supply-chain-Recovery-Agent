[TEMPLATE]
# Copy to .env and adjust. Never commit real secrets.
#
# No secret belongs in this file: it documents the variable names only, and
# .gitignore excludes the real .env.

# --- Application ---
APP_NAME=supply-chain-agent-backend
ENVIRONMENT=development
DEBUG=false
AUTO_SEED=true

# --- Server ---
HOST=127.0.0.1
PORT=8000
# Comma-separated list of allowed browser origins. '*' is rejected: list the
# frontend origins explicitly.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database ---
# SQLite by default so there is no external service to run.
DATABASE_URL=sqlite:///./supply_chain.db
SQL_ECHO=false

# --- Rate limiting ---
# Applied to every endpoint. The agent trigger and the optimizer each get their
# own tighter limit, since both do caller-driven work per request.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=200/minute
RATE_LIMIT_AGENT=10/minute
RATE_LIMIT_OPTIMIZE=60/minute

# --- Agent ---
# Groq model used only when an LLM explainer is configured below. Groq retired
# llama-3.3-70b-versatile on 2026-08-16, so this default is its recommended
# replacement. Any Groq chat model id works here.
AGENT_EXPLAINER_MODEL=openai/gpt-oss-120b
# Seconds before a single explainer call is abandoned and the deterministic
# template takes over.
AGENT_EXPLAINER_TIMEOUT=30
# Token budget for one call. A reasoning model bills its thinking to the same
# budget as its answer, so this must clear the reasoning burn with room to
# write: at 700 the model returned empty text (finish_reason=length) and every
# run fell back to the template.
AGENT_EXPLAINER_MAX_TOKENS=2048
# How much thinking a reasoning model may spend on a three-sentence summary.
# "low" keeps a live demo responsive; leave empty for models that reject it.
AGENT_EXPLAINER_REASONING_EFFORT=low

# --- Secrets (inject from the environment; never commit a real value) ---
# Guards every state-changing endpoint via the X-API-Key header. Required
# whenever ENVIRONMENT is not development or test, where an unset key is a
# startup error rather than an open door.
# API_KEY=
#
# Leave unset to use the deterministic template explainer (no network calls).
# When set, the closing explanation is written by Groq and then verified against
# the reasoning trace; anything citing a number no tool returned is discarded and
# the summary is regenerated once under stricter instructions.
# GROQ_API_KEY=
